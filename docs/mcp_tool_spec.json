{
  "server": {
    "name": "woocommerce-connector",
    "mode": "read-only"
  },
  "tools": [
    {
      "name": "list_orders",
      "description": "List recent orders, newest first.\n\nUse this only to browse. If you know anything about what you are\nlooking for (a status, a date range, a customer, a product), use\n`search_orders` instead so the store does less work.\n\nstatus: any of pending, processing, on-hold, completed, cancelled,\nrefunded, failed, or \"any\". Dates are YYYY-MM-DD or full ISO 8601.",
      "input_schema": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "created_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created After"
          },
          "created_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created Before"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "per_page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Per Page"
          }
        },
        "title": "list_ordersArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "search_orders",
      "description": "Find orders by status, free text, date range, customer or product.\n\n`search` matches the order number, billing name and billing email, so\nit is the right tool when a customer gives you an email address or an\norder number. Prefer narrow filters: each page is a live request\nagainst the merchant's shop.",
      "input_schema": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "search": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Search"
          },
          "created_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created After"
          },
          "created_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created Before"
          },
          "modified_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Modified After"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Customer Id"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Product Id"
          },
          "order_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Order By"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Direction"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "per_page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Per Page"
          }
        },
        "title": "search_ordersArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_order",
      "description": "Get one order in full, with line items, refund rows and signals.\n\nRead `signals.reconciliation` before answering any refund question.\nA refund row in WooCommerce only proves a shop manager clicked\nrefund; the Razorpay `rfnd_` id is what proves the money moved.",
      "input_schema": {
        "properties": {
          "order_id": {
            "title": "Order Id",
            "type": "integer"
          },
          "max_refunds": {
            "default": 20,
            "title": "Max Refunds",
            "type": "integer"
          }
        },
        "required": [
          "order_id"
        ],
        "title": "get_orderArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "list_order_refunds",
      "description": "List the refund rows recorded against one order.\n\nThese are WooCommerce's own records. Cross-check the Razorpay refund\nids in the order's `signals.payment_refs.refund_id` before telling a\ncustomer a refund has been sent.",
      "input_schema": {
        "properties": {
          "order_id": {
            "title": "Order Id",
            "type": "integer"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "per_page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Per Page"
          }
        },
        "required": [
          "order_id"
        ],
        "title": "list_order_refundsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "list_products",
      "description": "Find products by name, SKU, stock status or publication status.\n\nstock_status is one of instock, outofstock, onbackorder. Useful for\n\"is this back in stock yet?\" without guessing from order data.",
      "input_schema": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "stock_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stock Status"
          },
          "search": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Search"
          },
          "sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sku"
          },
          "order_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Order By"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Direction"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "per_page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Per Page"
          }
        },
        "title": "list_productsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_product",
      "description": "Get one product: price, sale price, stock level, SKU and a short\ndescription.\n\nUse this to confirm availability or pricing before answering a\ncustomer. Stock figures are whatever the store currently reports and\ncan move between this call and the customer reading your reply.",
      "input_schema": {
        "properties": {
          "product_id": {
            "title": "Product Id",
            "type": "integer"
          }
        },
        "required": [
          "product_id"
        ],
        "title": "get_productArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "find_customers",
      "description": "Find customer accounts by name or email.\n\nOnly matches registered accounts. A guest checkout has no customer\nrecord, so if this returns nothing use `customer_order_history` with\nthe email, which falls back to searching orders.",
      "input_schema": {
        "properties": {
          "search": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Search"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Email"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "per_page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Per Page"
          }
        },
        "title": "find_customersArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_customer",
      "description": "Get one customer account, with order count and lifetime spend.",
      "input_schema": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "integer"
          }
        },
        "required": [
          "customer_id"
        ],
        "title": "get_customerArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "customer_order_history",
      "description": "Everything this connector knows about one customer's orders.\n\nPass a customer_id or an email. Handles guest checkouts: if no\naccount matches the email, it searches orders by billing details\ninstead and says so in `matched_by`. This is the right first call for\n\"where is my order\" and \"where is my refund\".",
      "input_schema": {
        "properties": {
          "customer_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Customer Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Email"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "customer_order_historyArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "store_pulse",
      "description": "What needs attention in the store right now, ranked with reasons.\n\nOne call returns the recent order mix by payment state, intent and\ngateway, plus a ranked `needs_attention` list. Each entry carries\n`why`, the plain-language reasons behind its rank, so the merchant\ncan audit the ordering.\n\n`refunds_not_confirmed_at_gateway` is the list worth reading first:\nthose are refunds WooCommerce believes are done but that carry no\nRazorpay refund id.",
      "input_schema": {
        "properties": {
          "days": {
            "default": 14,
            "title": "Days",
            "type": "integer"
          },
          "scan": {
            "default": 100,
            "title": "Scan",
            "type": "integer"
          },
          "top": {
            "default": 10,
            "title": "Top",
            "type": "integer"
          }
        },
        "title": "store_pulseArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "connector_status",
      "description": "Check the connection, the key's visibility and the rate budget.\n\nCall this first if another tool failed with auth_failed or\nrate_limited, and tell the user what it reports rather than retrying.",
      "input_schema": {
        "properties": {},
        "title": "connector_statusArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    }
  ],
  "prompts": [
    {
      "name": "resolve_payment_question",
      "description": "Safely answer 'where is my refund / was I charged twice?'."
    },
    {
      "name": "daily_store_review",
      "description": "Morning triage for a shop manager."
    }
  ]
}
